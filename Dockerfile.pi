FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libopenblas-dev \
    liblapack-dev \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    libatlas-base-dev \
    libhdf5-dev \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements_pi.txt .
RUN pip install --no-cache-dir -r requirements_pi.txt

COPY . .

# Pre-download DeepFace FaceNet weights
RUN python -c "from deepface import DeepFace; DeepFace.build_model('Facenet')"

CMD ["python", "main.py"]
